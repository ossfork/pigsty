#!/bin/bash
#==============================================================#
# File      :   ssh
# Desc      :   write IaC output ssh config to ~/.ssh/pigsty_config
# Ctime     :   2024-11-23
# Mtime     :   2026-08-24
# Path      :   terraform/ssh
# Docs      :   https://pigsty.io/docs/deploy/terraform
# License   :   Apache-2.0 @ https://pigsty.io/docs/about/license/
# Copyright :   2018-2026  Ruohang Feng / Vonng (rh@vonng.com)
#==============================================================#
set -euo pipefail

PROG_NAME="$(basename "$0")"
PROG_DIR="$(cd "$(dirname "$0")" && pwd)"
IAC_CLI="${IAC_CLI:-tofu}"
PASSWORD='PigstyDemo4'

# OpenTofu is the default; set IAC_CLI=terraform for compatibility.
command -v "$IAC_CLI" >/dev/null || { echo "$PROG_NAME: $IAC_CLI is not installed" >&2; exit 1; }
command -v jq >/dev/null || { echo "$PROG_NAME: jq is not installed" >&2; exit 1; }

# Write IaC output SSH config to ~/.ssh/pigsty_config
cd "$PROG_DIR"
outputs=$("$IAC_CLI" output -json)

SSH_CONFIG_FILE="$HOME/.ssh/pigsty_config"
> "$SSH_CONFIG_FILE"

for key in $(echo "$outputs" | jq -r 'keys[]'); do
  ip=$(echo "$outputs" | jq -r ".${key}.value")
  shortname=$(echo "$key" | sed 's/_ip$//')
  hostname="${shortname}"
  {
    echo "Host $hostname"
    echo "  HostName $ip"
    echo "  User root"
    echo ""
  } >> "$SSH_CONFIG_FILE"
done

cat "$SSH_CONFIG_FILE"

for key in $(echo "$outputs" | jq -r 'keys[]'); do
  ip=$(echo "$outputs" | jq -r ".${key}.value")
  sshpass -p "$PASSWORD" ssh-copy-id -o StrictHostKeyChecking=no root@"$ip"
done
